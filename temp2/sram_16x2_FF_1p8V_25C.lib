            }
        }
    }

    pin(clk0){
        clock             : true;
        direction  : input; 
        capacitance : 0.006889999999999999;  
        internal_power(){
            when : "!csb0 & !web0"; 
            rise_power(scalar){
                values("4.662735e+00");
            }
            fall_power(scalar){
                values("3.581802e+00");
            }
        }
        internal_power(){
            when : "csb0 & !web0"; 
            rise_power(scalar){
                values("4.697316e+00");
            }
            fall_power(scalar){
                values("2.839932e+00");
