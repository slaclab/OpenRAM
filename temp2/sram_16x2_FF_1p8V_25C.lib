        min_capacitance : 0.0017224999999999999;  
        memory_read(){ 
            address : addr1; 
        }
        pin(dout1[31:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk1"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("1.003, 1.078, 1.316",\
                   "1.003, 1.079, 1.316",\
                   "1.01, 1.085, 1.323");
            }
            cell_fall(CELL_TABLE) {
            values("1.003, 1.078, 1.316",\
                   "1.003, 1.079, 1.316",\
                   "1.01, 1.085, 1.323");
            }
            rise_transition(CELL_TABLE) {
            values("0.026, 0.051, 0.137",\
                   "0.026, 0.051, 0.137",\
                   "0.026, 0.051, 0.137");
            }
            fall_transition(CELL_TABLE) {
            values("0.026, 0.051, 0.137",\
                   "0.026, 0.051, 0.137",\
                   "0.026, 0.051, 0.137");
            }
        }
        }
    }

    bus(addr1){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        max_transition       : 0.04;
        pin(addr1[3:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.09, 0.09, 0.09",\
