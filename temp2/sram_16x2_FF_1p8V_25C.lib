            rise_constraint(scalar) {
                values("1.953"); 
            }
            fall_constraint(scalar) {
                values("1.953"); 
            }
         }
        timing(){ 
            timing_type :"minimum_period"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("3.906"); 
            }
            fall_constraint(scalar) {
                values("3.906"); 
            }
         }
    }

    bus(din1){
        bus_type  : data; 
